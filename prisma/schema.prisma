// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── AUTH ───────────────────────────────────────────────────
model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  emailVerified    DateTime?
  image            String?
  password         String?           // hashed with bcrypt
  handle           String?           @unique // @username for leaderboard
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  subscription     Subscription?
  accounts         Account[]
  sessions         Session[]
  trades           Trade[]
  portfolio        Holding[]
  watchlist        WatchlistItem[]
  disciplineRules  DisciplineRule[]
  disciplineScores DisciplineScore[]
  aiFeedback       AiFeedback[]
  courseProgress   CourseProgress[]
  leaderboardOpt   Boolean           @default(true) // opt-in to leaderboard
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── SUBSCRIPTION ───────────────────────────────────────────
model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan      @default(FREE)
  status             SubStatus @default(ACTIVE)
  razorpaySubId      String?   @unique
  razorpayCustomerId String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

enum Plan {
  FREE
  PRO
}

enum SubStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

// ─── TRADE JOURNAL ──────────────────────────────────────────
model Trade {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime    @default(now())
  symbol           String
  exchange         String      @default("NSE")
  direction        TradeDir
  entryPrice       Decimal     @db.Decimal(12, 2)
  exitPrice        Decimal?    @db.Decimal(12, 2)
  quantity         Int
  lots             Int?
  strategyTag      String?
  disciplineChecks Json        // Array of {label: string, checked: boolean}
  notes            String?
  postTradeNotes   String?
  pnl              Decimal?    @db.Decimal(12, 2) // computed on save
  isOpen           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  aiFeedback       AiFeedback?
}

enum TradeDir {
  BUY
  SELL
}

model AiFeedback {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeId   String?      @unique
  trade     Trade?       @relation(fields: [tradeId], references: [id])
  type      FeedbackType
  content   Json         // {positivePattern, leakDetected, recommendation} or portfolio review JSON
  createdAt DateTime     @default(now())
}

enum FeedbackType {
  SESSION
  WEEKLY
  PORTFOLIO
}

// ─── DISCIPLINE ─────────────────────────────────────────────
model DisciplineRule {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  description   String?
  ruleType      RuleType
  value         Json     // flexible: {maxTrades: 3} or {startTime: "11:30", endTime: "13:15"}
  penaltyPoints Int      @default(5)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

enum RuleType {
  MAX_TRADES_PER_DAY
  HARD_STOP_LOSS
  NO_TRADING_WINDOW
  MIN_RISK_REWARD
  NO_REVENGE_TRADE_WINDOW
  CUSTOM
}

model DisciplineScore {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  score      Int      // 0-100
  violations Json     // Array of {rule, deduction, timestamp}
  baseScore  Int      @default(100)
  createdAt  DateTime @default(now())

  @@unique([userId, date])
}

// ─── PORTFOLIO ──────────────────────────────────────────────
model Holding {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  exchange  String    @default("NSE")
  buyPrice  Decimal   @db.Decimal(12, 2)
  quantity  Int
  buyDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── WATCHLIST ──────────────────────────────────────────────
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  exchange  String   @default("NSE")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
}

// ─── COURSES ────────────────────────────────────────────────
model Course {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  excerpt      String
  content      String           // Markdown / rich text
  category     CourseCategory
  difficulty   CourseDifficulty
  coverImage   String?
  estimatedMin Int              @default(30)
  isPublished  Boolean          @default(false)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  progress     CourseProgress[]
}

enum CourseCategory {
  BEGINNER
  INTERMEDIATE
  OPTIONS
  FUTURES
  PSYCHOLOGY
  STRATEGY
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model CourseProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, courseId])
}

// ─── MARKET CACHE ───────────────────────────────────────────
model MarketCache {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. "pre-market-data", "fii-dii"
  data      Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}
